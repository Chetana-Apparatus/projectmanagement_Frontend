PORT=6008
# Next proxy target (same as Django). Browser uses same-origin /api when API host is local — see next.config rewrites.
# If proxy still fails, try http://localhost:8000 instead of 127.0.0.1 (same machine networking).
BACKEND_API_ORIGIN=http://127.0.0.1:8000
# Remote API only (staging/prod split). Optional in local dev if you use the /api proxy.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
base_url=http://127.0.0.1:8000/
