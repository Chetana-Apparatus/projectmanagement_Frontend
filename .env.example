# -----------------------------------------------------------------------------
# Copy to `.env`. Restart `npm run dev` after any change.
#
# Browser → http://localhost:<port>/api/v1/... → Next.js proxies to BACKEND_API_ORIGIN.
#
# Local API testing (`next dev`): defaults are also in `.env.development`
# (Django at http://127.0.0.1:8000). Override per-machine in `.env.local` or
# `.env.development.local`.
# -----------------------------------------------------------------------------

PORT=3000

BACKEND_API_ORIGIN=http://127.0.0.1:8000

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_base_url=http://127.0.0.1:8000/
