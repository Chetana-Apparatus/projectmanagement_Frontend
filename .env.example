# -----------------------------------------------------------------------------
# Copy to `.env`. Restart `npm run dev` after any change.
#
# Browser → http://localhost:<port>/api/v1/... → Next.js proxies to BACKEND_API_ORIGIN.
#
# Deployed API testing (`next dev`): defaults are also in `.env.development`
# (Django at http://187.127.139.247:6009). Override per-machine in `.env.local` or
# `.env.development.local`.
# -----------------------------------------------------------------------------

PORT=3000

BACKEND_API_ORIGIN=http://187.127.139.247:6009

NEXT_PUBLIC_API_BASE_URL=http://187.127.139.247:6009
NEXT_PUBLIC_base_url=http://187.127.139.247:6009/
